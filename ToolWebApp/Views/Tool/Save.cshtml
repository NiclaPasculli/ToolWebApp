@model ToolWebApp.Domain.Tool

@{
    ViewBag.Title = "Save";
}

<style>
    .hidden-attributes {
        display: none;
    }
</style>
@using ResourceTool

@section scripts {

    @Scripts.Render("~/bundles/jqueryval")

    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link href="https://cdn.datatables.net/v/dt/jq-3.6.0/dt-1.13.4/b-2.3.6/fc-4.2.2/sc-2.1.1/sb-1.4.2/sp-2.1.2/sl-1.6.2/sr-1.2.2/datatables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/v/dt/jq-3.6.0/dt-1.13.4/b-2.3.6/fc-4.2.2/sc-2.1.1/sb-1.4.2/sp-2.1.2/sl-1.6.2/sr-1.2.2/datatables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.all.min.js"></script>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" />


    <script>
        $(document).ready(function () {
            $('#saveForm').submit(function (e) {
                e.preventDefault();


                initializeDataTable();
            });


            $("#showAttributesButton").click(function () {
                $(".hidden-attributes").show();
            });
        });


        function initializeDataTable() {
            $('#toolTable').DataTable();
        }
    </script>

}









@using (Html.BeginForm("Save", "Tool", FormMethod.Post, new { id = "saveForm" }))
{
    @Html.AntiForgeryToken()

    if ((bool)(ViewData["IsDetail"] ?? false))
    {
        <h2>Detail - @Model.IdTool</h2>
        @*<h2>Detail - @Model.IdTool</h2>
            <div class="form-group">
                @Html.LabelFor(model => model.IdTool, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <p class="form-control-static">@Model.IdTool</p>
                    @Html.HiddenFor(model => model.IdTool)
                </div>
            </div>*@


    }


    else
    {
        if (Model.IdTool == null)
        {
            <div class="form-group">
                @Html.LabelFor(model => model.IdTool, htmlAttributes: new { @class = "control-label col-md-2" })
                @Html.TextBoxFor(model => model.IdTool, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.IdTool, "", new { @class = "text-danger" })
            </div>
        }
        else
        {
            <h2>Edit - @Model.IdTool</h2>
            @*<div class="form-group">*@
            @*@Html.LabelFor(model => model.IdTool, htmlAttributes: new { @class = "control-label col-md-2" })*@
            @*<div class="col-md-10">*@
            @*<p class="form-control-static">@Model.IdTool</p>*@
            @Html.HiddenFor(model => model.IdTool)
            @*</div>*@
            @*</div>*@



        }
    }
    if ((bool)(ViewData["IsDetail"] ?? false))
    {

        <div class="form-group row">
            <label for="static" class="col-sm-2 col-form-label">@ResourceTool.Resource1.BoschCodeCol</label>
            <div class="col-sm-10">
                <input type="text" readonly class="form-control-plaintext" id="static" value=@Model.BoschCode>
            </div>
        </div>


        <div class="form-group row">
            <label for="static" class="col-sm-2 col-form-label">@ResourceTool.Resource1.DescriptionCol</label>
            <div class="col-sm-10">
                <input type="text" readonly class="form-control-plaintext" id="static" value=@Model.Description>
            </div>
        </div>

        <div class="form-group row">
            <label for="static" class="col-sm-2 col-form-label">@ResourceTool.Resource1.PrimarySupplierCol</label>
            <div class="col-sm-10">
                <input type="text" readonly class="form-control-plaintext" id="static" value=@Model.PrimarySupplier>
            </div>
        </div>
        <div class="form-group row">
            <label for="static" class="col-sm-2 col-form-label">@ResourceTool.Resource1.SecondarySupplierCol</label>
            <div class="col-sm-10">
                <input type="text" readonly class="form-control-plaintext" id="static" value=@Model.SecondarySupplier>
            </div>
        </div>

        <div class="form-group row">
            <label for="static" class="col-sm-2 col-form-label">@ResourceTool.Resource1.QuantityCol</label>
            <div class="col-sm-10">
                <input type="text" readonly class="form-control-plaintext" id="static" value=@Model.Quantity>
            </div>
        </div>
        <div class="form-group row">
            <label for="static" class="col-sm-2 col-form-label">@ResourceTool.Resource1.TurretCodeCol</label>
            <div class="col-sm-10">
                <input type="text" readonly class="form-control-plaintext" id="static" value=@Model.TurretCode>
            </div>
        </div>
    }
    else
    {
        <div class="form-group">
            <label>@ResourceTool.Resource1.BoschCodeCol</label>
            @Html.TextBoxFor(model => model.BoschCode, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.BoschCode)
        </div>
        <div class="form-group">
            <label>@ResourceTool.Resource1.DescriptionCol</label>
            @Html.TextBoxFor(model => model.Description, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Description)
        </div>

        <div class="form-group">
            <label>@ResourceTool.Resource1.QuantityCol</label>
            @Html.TextBoxFor(model => model.Quantity, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Quantity)
        </div>

        <div class="form-group">
            <label>@ResourceTool.Resource1.TurretCodeCol</label>
            @Html.DropDownListFor(model => model.TurretCode, (SelectList)ViewBag.TurretCodeList, "-- Select Turret Code --", new { @class = "form-control" })
            @*@Html.DropDownListFor(model => model.TurretCode, (SelectList)ViewBag.TurretCodeList, "-- Select Turret Code --", new { @class = "form-control" })*@
            @Html.ValidationMessageFor(model => model.TurretCode)
        </div>



        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>@ResourceTool.Resource1.PrimarySupplierCol</label>
                    @Html.TextBoxFor(model => model.PrimarySupplier, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.PrimarySupplier)
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>@ResourceTool.Resource1.SecondarySupplierCol</label>
                    @Html.TextBoxFor(model => model.SecondarySupplier, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.SecondarySupplier)
                </div>
            </div>
        </div>

        @*<div class="form-group">
                @Html.LabelFor(model => model.PrimarySharpener)
                @Html.TextBoxFor(model => model.PrimarySharpener, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.PrimarySharpener)
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.SecondarySharpener)
                @Html.TextBoxFor(model => model.SecondarySharpener, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SecondarySharpener)
            </div>*@



        <button type="submit" class="btn btn-primary">Save</button>

    }

    if ((bool)(ViewData["IsDetail"] ?? false))
    {
        <h4>Other Attributes</h4>
        <div class="form-group row">
            <label for="static" class="col-sm-2 col-form-label">@ResourceTool.Resource1.PrimarySharpenerCol</label>
            <div class="col-sm-10">
                <input type="text" readonly class="form-control-plaintext" id="static" value=@Model.PrimarySharpener>
            </div>
        </div>
        <div class="form-group row">
            <label for="static" class="col-sm-2 col-form-label">@ResourceTool.Resource1.SecondarySharpenerCol</label>
            <div class="col-sm-10">
                <input type="text" readonly class="form-control-plaintext" id="static" value=@Model.SecondarySharpener>
            </div>
        </div>

        <div class="hidden-attributes">
            @Html.LabelFor(model => model.PresettingQuoteNGEM1, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.PresettingQuoteNGEM1</p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.PresettingQuoteNGEM2, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.PresettingQuoteNGEM2</p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.PresettingDiameter, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.PresettingDiameter </p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.Presetting, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.Presetting </p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.Life, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.Life</p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.SProposal, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.SProposal </p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.FProposal, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.FProposal </p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.SValue, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.SValue </p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.FValue, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.FValue </p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.Refrigeration, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.Refrigeration </p>
            </div>
        </div>
        <div class="hidden-attributes">
            @Html.LabelFor(model => model.Accessories, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.Accessories </p>
            </div>
        </div>



        <button type="button" class="btn btn-success" onclick="toggleAttributes(this)">Show Other Attributes</button>

        <button type="button" class="btn btn-warning" onclick="GetSaveModal('@Model.IdTool')"> Edit </button>
        <button type="button" class="btn btn-danger" onclick="confirmDelete(event, '@Model.IdTool' )">Delete</button>
    }






}
