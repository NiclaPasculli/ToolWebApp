@model IEnumerable<ToolWebApp.Domain.Tool>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.all.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link href="https://cdn.datatables.net/1.11.1/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.0.0/css/buttons.dataTables.min.css" rel="stylesheet" />

    <script src="https://cdn.datatables.net/1.11.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.0.0/js/dataTables.buttons.min.js"></script>


    <script src="https://unpkg.com/xlsx/dist/xlsx.full.min.js"></script>

    <script src=" https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.0/js/dataTables.buttons.min.js"></script>
    <script src=" https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src=" https://cdn.datatables.net/buttons/2.4.0/js/buttons.html5.min.js"></script>
    <script src=" https://cdn.datatables.net/buttons/2.4.0/js/buttons.print.min.js"></script>


    <script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>

    <script src="https://larsjung.de/kjua/latest/kjua-0.9.0.min.js"></script>

 
    


    <script>
        $(document).ready(function () {
            initializeDataTable();
            generateQRCodes();
            $('#exportButton').on('click', function () {
                $('#toolTable').DataTable().button('.buttons-excel').trigger();
            });
        });


        function initializeDataTable() {
            $('#toolTable').DataTable({
                "scrollY": "450px",
                "scrollCollapse": true,
                "paging": true,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: 'Esporta in Excel',
                        exportOptions: {
                            columns: ':lt(7):not(.exclude-export)'
                        }
                    }
                ]
            });
        }



        function confirmDelete(event, id) {
            event.preventDefault();
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    deleteRecord(id);
                }
            });
        }

        function deleteRecord(id) {
            $.ajax({
                url: '@Url.Action("Delete", "Tool")',
                type: 'POST',
                data: { id: id },
                success: function (data) {
                    Swal.fire(
                        'Deleted!',
                        'Your file has been deleted.',
                        'success').then(function () {
                            window.location.href = '@Url.Action("GetAll", "Tool")';
                        });



                    $('#ToolTableDiv').html(data);
                    initializeDataTable();

                },
                error: function () {
                    console.log("error");
                }
            });
        }
function attachSaveFormSubmit() {
    $('#saveForm').submit(function (e) {
        e.preventDefault();
        $.ajax({
            url: '@Url.Action("Save", "Tool")',
            type: 'POST',
            data: $(this).serialize(),
            success: function (data) {
                if (data.errors && data.errors.length > 0) {
                    var errorMessages = '';
                    for (var i = 0; i < data.errors.length; i++) {
                        errorMessages += data.errors[i] + '\n';
                    }
                    alert(errorMessages);
                } else {
                    Swal.fire('Saved!', 'Tool salvato correttamente', 'success').then(function () {
                        window.location.href = '@Url.Action("GetAll", "Tool")';
                    });
                }
            },
            error: function () {
                alert('Si è verificato un errore durante il salvataggio.');
            }
        });
    });
}

function GetSaveModal(id) {
    $.ajax({
        url: '@Url.Action("GetSaveModal", "Tool")',
        type: 'POST',
        data: { id: id },
        success: function (data) {
            $('#newModal').html(data);
            $('#saveModal').modal('show');
            attachSaveFormSubmit();
        },
        error: function (data) {
            console.log("error");
            console.log(data);
        }
    });
}

function GetSave() {
    $.ajax({
        url: '@Url.Action("GetSaveModal", "Tool")',
        type: 'GET',
        success: function (data) {
            $('#newModal').html(data);
            $('#saveModal').modal('show');
            attachSaveFormSubmit();
        },
        error: function () {
            console.log("error");
        }
    });
        }



        function GetDetail(id) {
    $.ajax({
        url: '@Url.Action("Detail", "Tool")',
        type: 'GET',
        data: { id: id },
        success: function (data) {
            $('#newModal').html(data);
            $('#saveModal').modal('show');
            attachSaveFormSubmit();

            var backButton = $('<button>').addClass('btn btn-secondary').text('Back');
            backButton.on('click', function () {
                window.location.href = '@Url.Action("GetAll", "Tool")';
            });
            $('#saveModal .modal-footer').html(backButton);
        },
        error: function (data) {
            console.log("error");
            console.log(data);
        }
    });
}


        function toggleAttributes(button) {
            var hiddenAttributes = $('.hidden-attributes');
            hiddenAttributes.toggle();

            if (hiddenAttributes.is(':visible')) {
                button.innerText = 'Hide Other Attributes';
            } else {
                button.innerText = 'Show Other Attributes';
            }
        }




 function GetSearchModal() {
        $.ajax({
            url: '@Url.Action("Search", "Tool")',
            type: 'GET',
            success: function (data) {
                /*$('#newModal').html(data);*/
                $('#searchModal').modal('show');
            },
            error: function () {
                console.log("error");
            }
        });
        }



    function searchTool() {
        var formData = $('#searchForm').serialize();
        $.ajax({
            url: '@Url.Action("Search", "Tool")',
            type: 'POST',
            data: formData,
            success: function (data) {
               /* $('#searchModal').modal('hide');*/
                $('#viewSearch').html(data);
            },
            error: function () {
                console.log("error");
            }
        });
    }

        function generateQRCodes() {
            $('#toolTable tbody tr').each(function () {
                var toolId = $(this).find('td:nth-child(1)').text().trim();
                var boschCode = $(this).find('td:nth-child(2)').text().trim();
                var quantity = $(this).find('td:nth-child(6)').text().trim();

                var qrDiv = $('<div>').addClass('qrcode'); 
                $(this).find('.qrcode-column').empty().append(qrDiv); 

                var qrText = 'toolId=  ' + toolId + ',  boschCode= ' + boschCode + ',  quantity= ' + quantity; 

                new QRCode(qrDiv.get(0), {
                    text: qrText,
                    width: 50,
                    height: 50
                });
            });
        }






    </script>
}



<div id="ToolTableDiv">
    @Html.Partial("ToolTable", Model)
</div>

<div class="modal" id="saveModal" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"></h5>


            </div>
            <div class="modal-body" id="newModal">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#saveModal').modal('toggle');">Close</button>

            </div>

        </div>
    </div>
</div>







<div class="modal" id="searchModal" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Search Tool</h5>
            </div>
            <div class="modal-body" id="newModal">
                @using (Html.BeginForm("Search", "Tool", FormMethod.Post, new { id = "searchForm" }))
                {
                    <div>
                        <div style="display: inline-block;">
                            <label for="id">ID:</label>
                            @Html.TextBox("id", null, new { id = "id", @class = "form-control" })
                        </div>
                        <div style="display: inline-block;">
                            <label for="turretCode">TurretCode:</label>
                            @Html.TextBox("turretCode", null, new { id = "turretCode", @class = "form-control" })
                        </div>
                    </div>
                    @*<div>
                            <label for="turretCode">TurretCode:</label>
                            @Html.TextBox("turretCode", null, new { id = "turretCode" })
                        </div>*@
                    <button type="button" class="btn btn-primary" onclick="searchTool()">Search</button>
                }
                <div id="viewSearch">

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="$('#searchModal').modal('toggle');">Close</button>
            </div>
        </div>
    </div>
</div>


<button type="button" class="btn btn-primary" onclick="GetSave()"> New Tool </button>

<button type="button" class="btn btn-primary" onclick="GetSearchModal()">Search Tool</button>


