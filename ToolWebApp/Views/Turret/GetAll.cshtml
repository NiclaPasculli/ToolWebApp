@model IEnumerable<ToolWebApp.Domain.Turret>

@{
    ViewBag.Title = "GetAll";
}

<h2>GetAll</h2>
<style>
    table, th, td {
        border: 1px solid black;
        border-collapse: collapse;
        border-style: outset;
    }
</style>
<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table id="turretTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TurretCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id=" turretTableBody">
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TurretCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.TurretCode }) |
                    @Html.ActionLink("Detail", "Detail", new { id = item.TurretCode }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.TurretCode })
                </td>
            </tr>
        }
    </tbody>
</table>
@section scripts {

    <link href="https://cdn.datatables.net/v/dt/jq-3.6.0/dt-1.13.4/b-2.3.6/fc-4.2.2/sc-2.1.1/sb-1.4.2/sp-2.1.2/sl-1.6.2/sr-1.2.2/datatables.min.css" rel="stylesheet" />

    <script src="https://cdn.datatables.net/v/dt/jq-3.6.0/dt-1.13.4/b-2.3.6/fc-4.2.2/sc-2.1.1/sb-1.4.2/sp-2.1.2/sl-1.6.2/sr-1.2.2/datatables.min.js"></script>

    <script>
        $(document).ready(function (result) {
            $('#turretTable').DataTable({
                "scrollY": "450px",
                "scrollCollapse": true,
                "paging": true

            });
        });
    </script>


}

@Html.ActionLink("Home", "Index", "Home", null, new { @class = "btn btn-primary" })
